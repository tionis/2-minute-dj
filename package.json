{
  "name": "2-minute-dj",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:server": "tsx watch server/index.ts",
    "build": "next build --webpack",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "npm run start:server",
    "start:server": "node dist-server/server/index.js",
    "typecheck": "tsc -p tsconfig.check.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run typecheck && npm test && npm run build && npm run build:server"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@colyseus/core": "^0.17.50",
    "@colyseus/schema": "^4.0.31",
    "@colyseus/sdk": "^0.17.43",
    "@colyseus/ws-transport": "^0.17.13",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "lucide-react": "^0.562.0",
    "lz-string": "^1.5.0",
    "next": "^16.2.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "protobufjs": "^7.5.5",
    "lodash": "^4.18.1",
    "uuid": "^11.0.0"
  },
  "packageManager": "npm@9.2.0"
}
